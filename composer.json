{
    "name": "whilesmart/websearch",
    "description": "Provider-routed web search, page fetching, and structured feeds for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Whilesmart Team" }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/promises": "^2.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.22"
    },
    "suggest": {
        "laravel/mcp": "Exposes the search, fetch, and source tools over MCP."
    },
    "autoload": {
        "psr-4": {
            "Whilesmart\\WebSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Whilesmart\\WebSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Whilesmart\\WebSearch\\WebSearchServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
